{
  "name": "@voult/express",
  "version": "0.1.0",
  "description": "Mountable Express BFF for Voult authentication",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "voult",
    "express",
    "authentication",
    "authorization",
    "bff"
  ],
  "author": "Samuel Olabode",
  "license": "MIT",
  "peerDependencies": {
    "express": "^4.21.0 || ^5.0.0",
    "voult-sdk": ">=0.0.4"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^24.3.0",
    "@types/supertest": "^6.0.3",
    "express": "^5.2.1",
    "supertest": "^7.1.4",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "voult-sdk": "*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/voult-dev/voult-sdk",
    "directory": "packages/express"
  },
  "bugs": {
    "url": "https://github.com/voult-dev/voult-sdk/issues"
  },
  "homepage": "https://github.com/voult-dev/voult-sdk/tree/main/packages/express#readme",
  "publishConfig": {
    "access": "public"
  }
}
