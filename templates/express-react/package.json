{
  "name": "voult-express-react-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"node --env-file=.env --watch backend/server.js\" \"vite\"",
    "build": "vite build",
    "start": "node --env-file=.env backend/server.js",
    "doctor": "voult doctor --callback-url http://localhost:5173/api/auth/oauth/callback"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^14.0.0",
    "@voult/express": "^0.4.0",
    "@voult/react": "^0.2.0",
    "@voult/sdk": "^0.2.2",
    "express": "^5.2.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "@voult/cli": "^0.3.0",
    "concurrently": "^9.2.0",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=20.12"
  }
}
